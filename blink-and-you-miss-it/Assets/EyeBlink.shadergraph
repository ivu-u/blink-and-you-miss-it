{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "7f82fbeeeb724152a22795a9e9a53274",
    "m_Title": "Split",
    "m_Content": "The R channel in this case seems like left to right (the direction it gets more red in)\n\nThe G channel is the opposite with up and down.\n\nseems like there is no B or A channels so they default to black?\n\n\nQ: is it possible to have more than 4 channels? if so how would this work?",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4002.0,
        "y": -125.0,
        "width": 200.0,
        "height": 231.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

