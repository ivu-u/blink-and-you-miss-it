{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "8f701bb26e0a48e2a1dfe7fb8856297e",
    "m_Title": "Subtract",
    "m_Content": "Imagine the R channel is 0 to 1, where 0 is black (least red) and 1 is white (most red).\n\nWe subtract 0.5 from this which gives turns the channel to -0.5 to 0.5.\n\nthe middle 0 is black, and all negatives are also black (left side)\n\nbut the right side is shades of gray bc of the gradient of 0 to 0.5\n\n\n\nThere is still a grafient in the balck, but u cannot see this. ",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -3667.0,
        "y": -489.0,
        "width": 200.0,
        "height": 268.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

